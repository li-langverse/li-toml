# li-toml — TOML 1.0 subset parser (Li only).
# Phase A0: parse li-httpd config corpus; no httpd-specific logic here.

import parse_retpos

def toml_version() -> int
  requires true
  ensures result == 1
  decreases 0
=
  return 1

def toml_parse(buf: var ptr, len: var int) raises IO -> int
  requires true
  ensures -1 <= result
  ensures result <= 0
  decreases len + 1
=
  if len < 0:
    return -1
  if len == 0:
    return 0
  return toml_parse_document(buf, len)
